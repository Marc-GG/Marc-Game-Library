        <div class="col-md-7">
            <div class="card">
                <div class="card-body">

                    <div class="row">
                        <div class="col">   
                            <center>
                                <h4>Game Inventory List</h4>
                            </center>
                        </div>

                    </div>

                    <div class="row">
                        <div class="col">
                            <hr />
                        </div>
                    </div>


                    <div class="row">
                        <div class="col">
                            <!-- DataTables handles pagination, search, and sorting -->
                            <table id="InventoryTable" class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Game ID</th>
                                        <th>Game Name</th>
                                        <th>Genre</th>
                                        <th>Director Name</th>
                                        <th>Company Name</th>
                                        <th>Release Date</th>
                                        <th>Language</th>
                                        <th>Ratings</th>
                                        <th>Game Description</th>
                                        <th>Rental Stock</th>
                                        <th>Current Stock</th>
                                        <th>Game Image</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var game in Model.InventoryList)
                                    {
                                        <tr>
                                            <td>@game.GameID</td>
                                            <td>@game.GameName</td>
                                            <td>@game.Genre</td>
                                            <td>@game.DirectorName</td>
                                            <td>@game.CompanyName</td>
                                            <td>@game.ReleaseDate</td>
                                            <td>@game.Language</td>
                                            <td>@game.Ratings</td>
                                            <td>@game.GameDescription</td>
                                            <td>@game.RentalStock</td>
                                            <td>@game.CurrentStock</td>
                                            <td>@game.GameImage</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!--hidden image link-->
    <script>
            document.addEventListener('DOMContentLoaded', function () {
            const hiddenGameImageLink = document.getElementById('hiddenGameImageLink');

            if (hiddenGameImageLink && hiddenGameImageLink.value) {
                loadCheckedGameImage(hiddenGameImageLink.value);
            }
        });

        function loadCheckedGameImage(imagePath) {
            const hiddenImagePath = document.getElementById('hiddenImagePath');
            const preview = document.getElementById('gameImagePreview');

            if (hiddenImagePath && preview) {
                hiddenImagePath.value = imagePath;
                preview.src = imagePath || '/images/game.png';
            }
        }

    </script>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#InventoryTable').DataTable({
                paging: true,
                searching: true,
                lengthChange: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50, 100],
                ordering: false //disable sorting
            });
        });

    </script>
}

@if (TempData["SuccessMessage"] != null)
{
    <script>
        alert("@TempData["SuccessMessage"]");
    </script>
    TempData.Remove("SuccessMessage"); <!-- This is to prevent the message from being shown again -->
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        alert("@TempData["ErrorMessage"]");
    </script>
    TempData["ErrorMessage"] = null; // Clear the message to prevent it from showing again
}