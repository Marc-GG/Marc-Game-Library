@page
@model MarcFavoriteGames.Pages.mmanagementModel
@{
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col">
                            <center>
                                <h4>Member Details</h4>
                            </center>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col text-center">
                            <img src="/images/question.png" class="img-thumbnail" width="150" height="150" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col">
                            <hr />
                        </div>
                    </div>

                    <form method="post">
                        <div class="row">
                            <div class="col-md-4">
                                <label>Member ID</label>
                                <div class="mb-3">
                                    <div class="input-group">
                                        <input type="text" asp-for="MemberID" placeholder="Enter Member ID" class="form-control" />
                                        <button type="submit" asp-page-handler="SearchMember" class="btn btn-primary">Go</button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label>Full Name</label>
                                <div class="mb-3">
                                    <input type="text" value="@Model.FullName" class="form-control" readonly />
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label>Account Status</label>
                                <div class="input-group">
                                    <input type="text" value="@Model.AccountStatus" class="form-control me-1" readonly />
                                    <button type="submit" asp-page-handler="UpdateStatus" class="btn btn-success me-1" name="status" value="Active">
                                        <i class="fas fa-check-circle"></i>
                                    </button>
                                    <button type="submit" asp-page-handler="UpdateStatus" class="btn btn-warning me-1" name="status" value="Pending">
                                        <i class="fas fa-pause-circle"></i>
                                    </button>
                                    <button type="submit" asp-page-handler="UpdateStatus" class="btn btn-danger me-1" name="status" value="Inactive">
                                        <i class="fas fa-times-circle"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>

                    <div class="row">
                        <div class="col-md-4">
                            <label>Date of Birth</label>
                            <div class="mb-3">
                                <input type="text" asp-for="DOB" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label>Contact Number</label>
                            <div class="mb-3">
                                <input type="text" asp-for="ContactNo" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label>Email</label>
                            <div class="mb-3">
                                <input type="text" asp-for="Email" class="form-control" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            <label>State</label>
                            <div class="mb-3">
                                <input type="text" asp-for="State" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label>City</label>
                            <div class="mb-3">
                                <input type="text" asp-for="City" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label>Pin Code</label>
                            <div class="mb-3">
                                <input type="text" asp-for="Pincode" class="form-control" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <label>Full Address</label>
                            <div class="mb-3">
                                <textarea asp-for="FullAddress" class="form-control" rows="2" readonly></textarea>
                            </div>
                        </div>
                    </div>
                    <form method="post">
                        <input type="hidden" asp-for="MemberID" /> <!--This hidden input is to retain any data in MemberID after search so that it can be deleted-->
                        <div class="row">
                            <div class="col text-center">
                                <button type="submit" asp-page-handler="DeleteMember" class="btn btn-danger">Delete User Permanently</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card">
                <div class="card-body">
                    <h4>Member List</h4>
                    <!-- DataTables handles pagination, search, and sorting -->
                    <table id="memberTable" class="table table-striped">
                        <thead>
                            <tr>
                                <th>Member ID</th>
                                <th>Full Name</th>
                                <th>Date of Birth</th>
                                <th>Contact No</th>
                                <th>Email</th>
                                <th>State</th>
                                <th>City</th>
                                <th>Pincode</th>
                                <th>Full Address</th>
                                <th>Account Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var member in Model.MemberList)
                            {
                                <tr>
                                    <td>@member.MemberID</td>
                                    <td>@member.FullName</td>
                                    <td>@member.DOB</td>
                                    <td>@member.ContactNo</td>
                                    <td>@member.Email</td>
                                    <td>@member.State</td>
                                    <td>@member.City</td>
                                    <td>@member.Pincode</td>
                                    <td>@member.FullAddress</td>
                                    <td>@member.AccountStatus</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#memberTable').DataTable({
                paging: true,
                searching: true,
                lengthChange: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50, 100],
                ordering: false //disable sorting
            });
        });

    </script>
}

@if (TempData["SuccessMessage"] != null)
{
    <script>
        alert("@TempData["SuccessMessage"]");
    </script>
    TempData.Remove("SuccessMessage"); <!-- This is to prevent the message from being shown again -->
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        alert("@TempData["ErrorMessage"]");
    </script>
    TempData["ErrorMessage"] = null; // Clear the message to prevent it from showing again
}