@page
@model MarcFavoriteGames.Pages.InventoryModel
@Html.Raw(ViewData["Script"])
@{
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-5">

            <div class="card">
                <div class="card-body">   
                    <form method="post" enctype="multipart/form-data" novalidate>                     
                        <div class="col">
                            <center>
                                <h2>Game Inventory</h2>

                                <!-- Image preview (on top) -->
                                <img id="gameImagePreview" src="/images/game.png" alt="Game Image"
                                     style="max-width: 200px; max-height: 200px; margin-bottom: 10px;">

                                <!-- File input for uploading game image (below the image) -->
                                <div class="form-group">
                                    <label for="gameImage"></label>
                                    <input type="file" class="form-control" asp-for="GameImage"
                                           id="gameImageUpload" accept="image/*" onchange="previewImage(event)" />
                                    <input type="hidden" id="hiddenImagePath" name="HiddenImagePath" />
                                </div>

                                <div class="form-group row mt-3">
                                   
                                        <div class="col-md-4">
                                            <label for="GameID">Game ID</label>
                                            <div class="input-group">
                                                <input type="text" id="GameID" class="form-control" asp-for="GameID"
                                                       placeholder="Enter Game ID" required />
                                                <button type="submit" asp-page-handler="Check"
                                                        class="btn btn-primary" title="Check Game ID">
                                                    <i class="fas fa-check-circle" style="color: white;"></i>
                                                </button>
                                            </div>
                                        </div>
                                  

                                    <div class="col-md-8">
                                        <label for="GameName">Game Name</label>
                                        <input type="text" class="form-control" asp-for="GameName" placeholder="Enter Game Name" />
                                    </div>
                                </div>
                                <!-- Hidden input for storing the retrieved game image link -->
                                <input type="hidden" id="hiddenGameImageLink" value="@ViewData["GameImageLink"]" />
                            </center>
                        </div>

                        <script>
                            // Handles image preview when a file is selected
                            function previewImage(event) {
                                const file = event.target?.files?.[0];
                                const preview = document.getElementById('gameImagePreview');
                                const hiddenImagePath = document.getElementById('hiddenImagePath')?.value || '/images/game.png';

                                if (file) {
                                    if (file.type.startsWith('image/')) {
                                        const reader = new FileReader();
                                        reader.onload = function (e) {
                                            preview.src = e.target.result;
                                        };
                                        reader.readAsDataURL(file);
                                    } else {
                                        alert('Please select a valid image file.');
                                        preview.src = hiddenImagePath;  // Fall back to existing image
                                    }
                                } else {
                                    preview.src = hiddenImagePath;
                                }
                            }

                            // Auto-fills the image preview when the 'Check' button populates data
                            function loadCheckedGameImage(imagePath) {
                                const hiddenImagePath = document.getElementById('hiddenImagePath');
                                const preview = document.getElementById('gameImagePreview');

                                if (hiddenImagePath && preview) {
                                    hiddenImagePath.value = imagePath;
                                    preview.src = imagePath || '/images/game.png';
                                }
                            }
                        </script>





